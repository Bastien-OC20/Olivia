# Copier en .env puis adapter.
OLLAMA_URL=http://localhost:11434
FS_ROOT=/home/vous/Documents

# Chemin de l'UI buildée (laisser vide = auto : frontend/dist)
# FRONTEND_DIST=

# Sécurité (optionnel) : si défini, toutes les routes /api/* exigent l'en-tête
# X-API-Token: <valeur>. Laisser vide pour un usage local simple.
# API_TOKEN=

# Optionnel : clé API Brave Search (https://brave.com/search/api/)
# BRAVE_API_KEY=BSA-xxxxxxxx
