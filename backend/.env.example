# Copier en backend/.env puis adapter. Lu au démarrage par backend/__init__.py ;
# une variable déjà définie dans l'environnement reste prioritaire.
OLLAMA_URL=http://localhost:11434

# Dossier de travail par défaut, tant qu'aucun dossier n'est choisi dans
# l'interface (Documents → Parcourir).
FS_ROOT=/home/vous/Documents

# Chemin de l'UI buildée (laisser vide = auto : frontend/dist)
# FRONTEND_DIST=

# Dossier des données d'Olivia (comptes, réglages, conversations). Vide = défaut :
# backend/ (disque portable, développement) ou celui désigné par olivia.ini
# (installation). Voir backend/emplacements.py.
# OLIVIA_DATA_DIR=

# Optionnel : clé API Brave Search (https://brave.com/search/api/), si elle n'est
# pas saisie dans Paramètres → Recherche web.
# BRAVE_API_KEY=BSA-xxxxxxxx
