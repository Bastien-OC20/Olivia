# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Moteur OCR portable (binaire + données de langue, ~190 Mo) : installé
# localement, jamais versionné — voir README, section OCR.
tesseract/

# Documents réels de l'établissement (RGPD : données personnelles —
# élèves, personnels, comptes rendus). Servent de jeu d'essai et de
# modèles de mise en page. Ne JAMAIS committer.
documents/

# Modèles de documents dérivés de la charte de l'établissement (logo,
# ours, polices). Propriété du lycée, générés localement : jamais versionnés.
modeles/

# --- Secrets & données locales (RGPD : ne jamais committer) ---
backend/settings.json
backend/settings.tmp
backend/conversations/
# Comptes, organisations et sessions ouvertes : dérivés de mots de passe et
# jetons de session vivants (voir backend/profiles.py, users.py, sessions.py).
# Ce dossier accueillera aussi les données cloisonnées par organisation.
backend/profiles/
# Texte reconnu sur les documents scannés : recopie du contenu de fichiers
# personnels, et cache reconstructible — jamais versionné.
backend/ocr_cache/
# Index vectoriel de la recherche par le sens (embeddings + métadonnées des
# extraits) : dérivé du contenu de documents personnels, et reconstructible —
# jamais versionné (RGPD).
backend/docindex/
backend/.env
.env
*.pem
*.key

# --- Uploads / données créées par l'app ---
_uploads/
backend/_uploads/

# --- Config SearXNG locale (contient un secret_key propre à la machine) ---
searxng/

# --- Build / distribution ---
dist/
build/
*.spec.bak

# Sortie de l'installeur Windows (Setup.exe + tranches .bin, ~11 Go avec les
# modèles embarqués) : reconstructible via ISCC "installer Olivia/olivia.iss",
# jamais versionnée. Le script .iss lui-même reste suivi.
installer Olivia/Sortie/
installer Olivia/*.log

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

